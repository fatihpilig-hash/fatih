# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Resend API key (https://resend.com/api-keys). Required for the
# contact form (/api/contact) to actually send emails.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hallo@plg-media.de

# Sender address. Until a custom domain is verified in Resend, you must
# use their shared sandbox sender "onboarding@resend.dev" (emails sent
# from it can only be delivered to the Resend account's own address).
# After verifying plg-media.de in Resend, switch this to e.g.
# kontakt@plg-media.de so recipients see your real domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev
