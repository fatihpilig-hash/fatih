# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Resend API key (https://resend.com/api-keys). Required for the
# contact form (/api/contact) to actually send emails.
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=info@plgmedia.de

# Sender address. plgmedia.de is verified in Resend, so any address on
# that domain works here (the mailbox itself doesn't need to exist —
# only the domain's SPF/DKIM records, which Resend already checked).
CONTACT_FROM_EMAIL=info@plgmedia.de
